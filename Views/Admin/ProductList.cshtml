@using App.Data.Entities
@model List<ProductEntity>

@{
    ViewBag.Title = "Ürün Listesi";
}

<h2>Ürün Listesi</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Ürün Adı</th>
            <th></th>
            <th>Fiyat</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
         @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>
                    <!-- Silme işlemi için form -->
                    <form method="post" action="@Url.Action("DeleteProduct", "Product")" 
                          onsubmit="return confirm('Bu ürünü silmek istediğinize emin misiniz?');">
                        <input type="hidden" name="id" value="@product.Id" />
                        <button type="submit" class="btn btn-danger">Sil</button>
                    </form>

                    |
                    <!-- Düzenle butonu -->
                    <a href="@Url.Action("UpdateProduct", "Product", new { id = product.Id })" class="btn btn-warning">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
