						<div class="col-12 tab-content shop-" id="pills-tabContent">
    <div class="tab-pane fade show active" id="tab-list-list" role="tabpanel" aria-labelledby="tab-list-list-btn">
        <div class="row">
            @foreach (var item in Model.productEntities) // Model.productEntities, sayfaya özel ürünleri içerecek
            {
                var category = Model.categories.FirstOrDefault(x => x.Id == item.CategoryId);
                var img = Model.images.FirstOrDefault(x => x.ProductId == item.Id);
                <div class="col-md-12 col-sm-12">
                    <div class="dz-shop-card style-2">
                        <div class="dz-media">
                            <img src="@img.Url" alt="product-image" />
                        </div>
                        <div class="dz-content">
                            <h2 class="title mb-0">
                                <a href="@Url.Action("ProductDetails", "Shop", new { id = item.Id })">@item.Name</a>
                            </h2>
                            <div class="dz-header">
                                <div>
                                    <h2 class="title mb-0"><a href="shop-with-category.html">@item.Name</a></h2>
                                    <ul class="dz-tags">
                                        <li><a href="shop-with-category.html">@category.Name</a></li>
                                    </ul>
                                </div>
                                <div class="d-flex">
                                    <a href="@Url.Action("AddToCart", "Cart", new { productId = item.Id, Quantity = 1 })"
                                        id="addToCartBtn" class="btn btn-secondary btn-md btn-icon">
                                        <i class="icon feather icon-shopping-cart d-md-none d-block"></i>
                                        <span class="d-md-block d-none">Add to cart</span>
                                    </a>
                                    <div class="bookmark-btn style-1">
                                        <input class="form-check-input" type="checkbox" id="favoriteCheck1">
                                        <label class="form-check-label" for="favoriteCheck1">
                                            <i class="flaticon flaticon-heart-3"></i>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="dz-body">
                                <div class="dz-rating-box">
                                    <div>
                                        <p class="dz-para">@item.Description</p>
                                    </div>
                                </div>
                                <div class="rate">
                                    <div class="d-flex align-items-center mb-xl-3 mb-2">
                                        <div class="meta-content">
                                            @if (item.DiscountId > 0)
                                            {
                                                var discount = Model.discounts.FirstOrDefault(x => x.Id == item.DiscountId);
                                                decimal newPrice = item.Price - (item.Price * discount.DiscountRate / 100);
                                                <span class="price">$@newPrice<del>$@item.Price</del></span>
                                            }
                                            else
                                            {
                                                <span class="price">$@item.Price</span>
                                            }
                                            @{
                                                int starCount = 0;
                                                var reviews = Model.comments.Where(x => x.ProductId == item.Id).ToList();
                                                @foreach (var review in reviews)
                                                {
                                                    starCount += review.StarCount;
                                                }
                                                if (reviews.Count > 0)
                                                {
                                                    starCount = starCount / reviews.Count;
                                                }
                                                else
                                                {
                                                    starCount = 0;
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="review-num">
                                        <ul class="dz-rating">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                if (i < starCount)
                                                {
                                                    <li class="star-fill">
                                                        <i class="flaticon-star-1"></i>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li>
                                                        <i class="flaticon-star-1"></i>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                        <span><a href="javascript:void(0);">@starCount</a></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Sayfalama Kısımları -->
<div class="row page mt-0">
    <div class="col-md-6">
        <p class="page-text">Showing @((Model.CurrentPage - 1) * 4 + 1)–@((Model.CurrentPage - 1) * 4 + Model.productEntities.Count) Of @Model.TotalProductCount Results</p>
    </div>
    <div class="col-md-6">
        <nav aria-label="Blog Pagination">
            <ul class="pagination style-1 p-t20">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("ProductList", "Shop", new { page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link next"
                        href="@Url.Action("ProductList", "Shop", new { page = Model.CurrentPage + 1 })">Next</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

