@section Scripts {
    <script>
        $(document).ready(function() {
            var priceMin = $("#priceMin");
            var priceMax = $("#priceMax");
            
            var minVal = parseInt(priceMin.val()) || 0;
            var maxVal = parseInt(priceMax.val()) || 1000;
            
            // Slider'ı başlat
            $("#slider-tooltips").slider({
                range: true,
                min: 0,
                max: 1000,
                values: [minVal, maxVal],
                slide: function(event, ui) {
                    // Slider değerlerini input elemanlarına yansıt
                    priceMin.val(ui.values[0]);
                    priceMax.val(ui.values[1]);

                    // Değerleri ekranda göster
                    $("#slider-margin-value-min").text("$" + ui.values[0]);
                    $("#slider-margin-value-max").text("$" + ui.values[1]);
                }
            });

            // İlk başta slider'ın değerlerini ekranda göster
            $("#slider-margin-value-min").text("$" + minVal);
            $("#slider-margin-value-max").text("$" + maxVal);
        });
    </script>
	<script>
    document.getElementById('addToCartBtn').addEventListener('click', function(event) {
        // Burada giriş yapmış olup olmadığını kontrol ediyorsunuz.
        var isUserLoggedIn = @User.Identity.IsAuthenticated.ToString().ToLower(); // ASP.NET Core'da oturum kontrolü

        if (!isUserLoggedIn) {
            event.preventDefault(); // Butonun normal işlevini engelle
            alert("Giriş yapmalısınız!"); // Giriş yapılmadığında uyarı mesajı
        }
    });
</script>
}
